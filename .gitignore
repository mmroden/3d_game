# Local tools (fetched via make deps)
/tools/

# Rust build artifacts
/rust/target/

# Godot editor artifacts
/godot/.godot/
/godot/.import/

# Asset formats we don't use in Godot
assets/**/FBX/
assets/**/FBX (Unity)/
assets/**/OBJ/
assets/**/Blends/
assets/**/Blend/
assets/**/Planet Textures/
assets/**/*.blend
assets/quaternius-megakit/Engine Projects/Unity (URP)/
assets/quaternius-megakit/Engine Projects/Unreal Engine/

# Archive extraction scratch (install-addons.sh; raw .rar/.zip stay tracked)
assets/**/unpacked/
# Seller material for humans (render galleries, PSDs) — never a pipeline
# input (install-addons.sh convert_environment), never in the repo.
assets/**/reference/
# A loose unzip of the hill house's texture archive (the archive is the
# LFS-tracked source; the door extracts it under unpacked/).
assets/hill_house/*Texture/
assets/apartment/textures/
# Generated by the material oracles (extract-max-materials.py,
# extract-fbx-materials.py, mtl_materials.py) during make assets — one
# table per converted pack
assets/**/max_materials.json
assets/**/fbx_materials.json
assets/**/mtl_materials.json
assets/**/conversion.json
assets/**/convert.opts
assets/**/scene_cache.blend.json
assets/apartment/scene_cache.blend
assets/**/*.blend1
scripts/__pycache__/
# Unused provider export (899 MB; the pipeline consumes the .max + .fbx)
assets/apartment/*.obj


# Godot addon build output (rebuilt via make assets)
/godot/addons/

# GDExtension dylib (copied in by make build / build-release)
/godot/libvoid_scavenger*.dylib

# Claude Code worktrees
.claude/worktrees/

# Serena MCP language-server state
.serena/

# Stray Godot import artifact
/.import

# OS
.DS_Store

# Capture-rig frame output (KEEP_FRAMES=1 make check-visual, reference shots)
/out/
